#include <zephyr/dt-bindings/led/led.h>


&spi2 {
    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";
        reg = <0>;
        spi-max-frequency = <6400000>;
        chain-length = <1>;
        color-mapping = <LED_COLOR_ID_GREEN
                         LED_COLOR_ID_RED
                         LED_COLOR_ID_BLUE>;
        reset-delay = <250>;
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;
    };
};

/ {
    aliases {
        led-strip = &led_strip;
    };
};

